# Server-only settings. Add to the same .env the ETL uses (POS_* and SUPABASE_* stay as they are).

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVER_API_KEY=change-me-to-a-long-random-string

# dry_run (default): rehearse only, change nothing.  commit: really write to POS.
POS_WRITE_MODE=dry_run

# JSON list of dashboard origins allowed by CORS
CORS_ORIGINS=["http://localhost:5173"]

# POS_SESSION_POOL_SIZE=1
# WALK_IN_CUSTOMER_ID=23
# UNCERTAIN_GRACE_SECONDS=300
# RECONCILE_INTERVAL_SECONDS=0        # >0 runs the reconcile loop in-process

# Register endpoints not yet verified against your POS (defaults are standard PHPPOS):
# POS_SALES_ADD_ITEM_PATH=/index.php/sales/add
# POS_SALES_EDIT_ITEM_PATH=/index.php/sales/edit_item/{line}
# POS_SALES_ADD_PAYMENT_PATH=/index.php/sales/add_payment
